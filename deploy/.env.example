# Copy to deploy/.env and change every value. deploy/.env is git-ignored.
BUILDER_DB_PASSWORD=change-me-db
BUILDER_ADMIN_USER=admin
BUILDER_ADMIN_PASSWORD=change-me-admin
# 32+ random characters, e.g. `openssl rand -hex 32`
BUILDER_JWT_KEY=change-me-0123456789abcdef0123456789abcdef
# shared secret agents present to the API, e.g. `openssl rand -hex 24`
BUILDER_AGENT_TOKEN=change-me-agent-token
BUILDER_AGENT_CAPACITY=2
BUILDER_AGENT_INSTALL_AZ=false
BUILDER_UI_PORT=19000
BUILDER_API_PORT=19100
# Socket the agents use for `docker ...` commands in your Taskfiles:
#   Docker:          /var/run/docker.sock
#   rootless Podman: /run/user/1000/podman/podman.sock   (systemctl --user enable --now podman.socket)
#   rootful Podman:  /run/podman/podman.sock
CONTAINER_SOCKET=/var/run/docker.sock
# Optional Google sign-in (see README): OAuth client, the public URL users open, and the allowed e-mail
BUILDER_GOOGLE_CLIENT_ID=
BUILDER_GOOGLE_CLIENT_SECRET=
BUILDER_PUBLIC_ORIGIN=
BUILDER_ALLOWED_EMAIL=
